# ── Required for real (non-demo) operation ────────────────────────────────
# Postgres connection string (Neon free tier via Vercel Marketplace).
# Without this the app runs in read-only DEMO mode with sample data.
DATABASE_URL=

# Long random string for signing session cookies (32+ chars).
AUTH_SECRET=

# The code you and your co-owner type on the /join page. Keep it private.
INVITE_CODE=

# Shared secret that authorizes the cron schedulers to trigger the engine.
CRON_SECRET=

# ── Optional integrations (each turns on automatically when set) ──────────
# Discord channel webhook — trade cards, alerts, daily summaries.
DISCORD_WEBHOOK_URL=

# Discord application public key — enables /status /pause /resume slash commands.
DISCORD_PUBLIC_KEY=

# Anthropic API key — Claude vets every entry and writes rationale (pennies/month).
ANTHROPIC_API_KEY=

# Alpaca PAPER keys — stock orders route to Alpaca's paper environment.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# OANDA practice token — FX orders route to OANDA's practice environment.
OANDA_TOKEN=
